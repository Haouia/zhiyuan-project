# 知源 · 企业级 RAG 知识引擎 —— 本地开发环境变量模板
# 这是本地开发模板：复制为 .env 后填写，或直接运行 ./scripts/start.ps1 自动生成。
#   PowerShell: Copy-Item .env.example .env
# 真实的 .env 已被 .gitignore 忽略，切勿提交；本文件的值全部是占位符，不含任何真实密码 / Token / API Key。
# 所有 RAG_*_PASSWORD、RAG_*_TOKEN、RAG_*_SIGNING_KEY 由 scripts/start.ps1 随机生成（32 字节），
# 手动填写时请使用同等强度的随机串，不要把真实口令写进代码、镜像、Compose 或文档。
# 键名与本机 .env 完全一致、顺序相同；带「必填」的键缺失时 docker compose 会直接报错。

# ---------------------------------------------------------------------------
# 一、数据库与基础设施凭证（Compose 必填）
# ---------------------------------------------------------------------------

# 必填。MySQL root 口令，仅用于初始化与运维，业务服务不使用
RAG_DB_ROOT_PASSWORD=change-me

# 必填。文档服务数据库账号 rag_doc 的口令
RAG_DOC_DB_PASSWORD=change-me

# 必填。检索服务数据库账号 rag_search 的口令
RAG_SEARCH_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 二、服务间调用令牌（Compose 必填，成对出现才有意义；长度不足会被网关拒绝）
# ---------------------------------------------------------------------------

# 必填。网关 → 文档服务
RAG_GATEWAY_DOC_TOKEN=change-me

# 必填。网关 / 各服务 → 评测服务
RAG_METRIC_TOKEN=change-me

# 必填。Nacos 鉴权身份 ID（NACOS_AUTH_IDENTITY_VALUE），任意随机串即可
RAG_NACOS_SERVER_ID=change-me

# 必填。Nacos 鉴权签名密钥（NACOS_AUTH_TOKEN），需为 Base64 编码的 32 字节随机串
RAG_NACOS_SIGNING_KEY=change-me

# 必填。检索服务 → 文档服务（核验生效版本）
RAG_SEARCH_DOC_TOKEN=change-me

# 必填。网关 → 问答服务
RAG_GATEWAY_AI_TOKEN=change-me

# 必填。问答服务 → 检索服务
RAG_AI_SEARCH_TOKEN=change-me

# 必填。问答服务 → 文档服务（回查引用原文）
RAG_AI_DOC_TOKEN=change-me

# 必填。Keycloak 主域管理员账号与口令：创建 realm、读取用户目录、注册新用户都依赖它
RAG_KEYCLOAK_ADMIN_USER=rag-admin
RAG_KEYCLOAK_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 三、对话模型接入（可选项；不配置即使用本地可控模型桩，不发送真实请求）
# ---------------------------------------------------------------------------

# 完整 Chat Completions 地址。默认指向本地模型桩 model-primary；
# 对接真实服务（如 DeepSeek）改为 https://api.deepseek.com/chat/completions，见 README「接入 DeepSeek」。
RAG_CHAT_URL=http://model-primary:8095/v1/chat/completions

# 模型名。本地桩用 fixture-primary；DeepSeek 可用 deepseek-flash 或 deepseek-v4-pro（单价更高）。
RAG_CHAT_MODEL=fixture-primary

# 模型服务 API Key。真实值只写入本地 .env，绝不提交；本地模型桩可留空。
RAG_CHAT_API_KEY=your-deepseek-api-key

# 思维链开关：留空表示不发送 thinking 字段（兼容不识别该参数的端点）；
# DeepSeek 默认开启思维链，填 disabled 可降低延迟与输出 Token。
RAG_CHAT_THINKING=

# 是否要求模型返回 JSON（response_format={"type":"json_object"}）；本地留空取 Compose 默认 true。
RAG_CHAT_JSON_MODE=true

# 单次模型调用超时（毫秒）。本地桩 6000 足够；真实网络往返更慢可调至 20000，仍应小于 40 秒问答预算。
RAG_CHAT_TIMEOUT_MS=6000

# 每百万 Token 的估算单价，仅用于用量与费用展示，不影响真实计费。
# 本地桩用 2 / 6；按 DeepSeek 高峰价折算约为 2.13 / 8.52（人民币，币种由 RAG_USAGE_CURRENCY 控制）。
RAG_CHAT_PRICE_INPUT_PER_MILLION=2
RAG_CHAT_PRICE_OUTPUT_PER_MILLION=6

# 备用端点。留空即关闭切备，避免主端点失败时静默回落到本地模型桩；
# 需要演练切备 / 熔断时填 http://model-backup:8096/v1/chat/completions 与 fixture-backup。
RAG_CHAT_BACKUP_URL=
RAG_CHAT_BACKUP_MODEL=
